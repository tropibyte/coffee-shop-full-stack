# ===========================================================================
# Coffee Shop API - environment template
#
#   cp .env.example .env     (PowerShell: Copy-Item .env.example .env)
#
# .env is gitignored and must never be committed. Every value below is read
# by src/config.py. See docs/AUTH0_SETUP.md for where each Auth0 value comes
# from.
# ===========================================================================

# --- Which configuration class to load -------------------------------------
# development | testing | production
FLASK_CONFIG=development
FLASK_APP=src.api

# --- Auth0: required -------------------------------------------------------
# Auth0 Dashboard > Applications > your SPA > Settings > Domain
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Auth0 Dashboard > Applications > APIs > Coffee Shop > Identifier
AUTH0_API_AUDIENCE=coffee-shop
# Auth0 Dashboard > Applications > your SPA > Settings > Client ID
# Used by the docs page and echoed in /health; not a secret.
AUTH0_CLIENT_ID=

# --- Auth0: token verification (safe defaults; change only with reason) -----
AUTH0_ALGORITHMS=RS256
AUTH0_LEEWAY_SECONDS=10
JWKS_CACHE_TTL_SECONDS=600
JWKS_FETCH_TIMEOUT_SECONDS=5
JWKS_MIN_REFRESH_INTERVAL_SECONDS=30

# --- Auth0 Management API: powers the user-administration endpoints ---------
# Auth0 Dashboard > Applications > "Coffee Shop Management (M2M)"
# SECRET. Never commit. Set MANAGEMENT_API_ENABLED=false to run without it.
MANAGEMENT_API_ENABLED=true
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_CONNECTION=Username-Password-Authentication

# --- Database --------------------------------------------------------------
# Default: SQLite at src/database/database.db.
# Azure App Service persists only /home, so point it there in production:
#   DATABASE_URL=sqlite:////home/data/database.db
DATABASE_URL=

# Destroys and rebuilds the schema on boot. Leave false unless you mean it.
DB_DROP_AND_CREATE_ALL=false
# Inserts demo drinks only when the table is empty. Non-destructive.
DB_SEED_IF_EMPTY=true

# --- Flask -----------------------------------------------------------------
# SECRET. Production requires >= 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Frontend --------------------------------------------------------------
# Comma-separated allow-list. Never use '*' with bearer tokens.
CORS_ORIGINS=http://localhost:8100,http://127.0.0.1:8100,http://localhost:4200,http://127.0.0.1:4200
# Where an invited user lands after setting their password.
FRONTEND_URL=http://localhost:8100

# --- Rate limiting ---------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=200 per minute
RATELIMIT_WRITE=30 per minute
RATELIMIT_ADMIN=60 per minute
# Use redis://... when running more than one instance; memory:// is per-process.
RATELIMIT_STORAGE_URI=memory://

# --- Observability ---------------------------------------------------------
LOG_LEVEL=INFO
# json for production and CI, console for a readable local log.
LOG_FORMAT=console
AUDIT_LOG_ENABLED=true

# --- Documentation ---------------------------------------------------------
# Serves /docs and /openapi.json.
DOCS_ENABLED=true
