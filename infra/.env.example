# Copy to infra/.env and fill in. Used only by docker-compose.
# infra/.env is gitignored.

# --- Auth0 (required) ------------------------------------------------------
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=coffee-shop
AUTH0_CLIENT_ID=

# --- Auth0 Management API (optional; powers the /users endpoints) ----------
MANAGEMENT_API_ENABLED=false
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# --- Application (required) ------------------------------------------------
# 32+ characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

LOG_LEVEL=INFO
